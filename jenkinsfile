pipeline {
    agent any
    
    environment {
        LABS = credentials('labcreds')
        JAVA_HOME = '/opt/bitnami/java'
        PATH = "${env.JAVA_HOME}/bin:/root/.local/bin:${env.PATH}"
    }
    
    stages {

        stage('Verify Environment') {
            steps {
                script {
                    sh 'python3 --version'
                    sh 'pip3 --version'
                    sh 'pipenv --version'
                    sh 'echo $PATH'
                }
            }
        }

        stage('Setup Virtual Environment') {
            steps {
                script {
                    // Create virtual environment
                    sh 'python3 -m venv retail_pipeline_venv'

                    // Upgrade pip inside venv
                    sh './retail_pipeline_venv/bin/pip install --upgrade pip'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    // Install project dependencies
                    sh 'pipenv install'
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    // Verify Java environment
                    sh 'echo $JAVA_HOME'
                    sh 'echo $PATH'

                    // Run tests
                    sh 'pipenv run pytest'
                }
            }
        }

        stage('Package') {
            steps {
                // Create zip excluding virtual environment
                sh 'zip -r retailproject.zip . -x "retail_pipeline_venv/*"'
            }
        }

        stage('Deploy') {
            steps {
                // Deploy artifact
                sh 'sshpass -p $LABS_PSW scp -o StrictHostKeyChecking=no -r retailproject.zip $LABS_USR@g02.itversity.com:/home/itv012419/retailproject'
            }
        }
    }
}