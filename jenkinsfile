pipeline {
    agent any
    
    environment {
        LABS = credentials('labcreds')
        JAVA_HOME = '/opt/bitnami/java'
        PATH = "${env.JAVA_HOME}/bin:${env.PATH}"
    }
    
    stages {
        stage('Setup Virtual Environment') {
            steps {
                script {
                    // Create virtual environment
                    sh 'python3 -m venv retail_pipeline_venv'

                    // Upgrade pip inside virtual environment
                    sh './retail_pipeline_venv/bin/pip install --upgrade pip'

                    // Verify pipenv installation
                    sh '/home/pradipchavan99000/.local/bin/pipenv --version'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    // Install dependencies using pipenv
                    sh '/home/pradipchavan99000/.local/bin/pipenv install'
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    // Verify Java environment
                    sh 'echo $JAVA_HOME'
                    sh 'echo $PATH'

                    // Run tests
                    sh '/home/pradipchavan99000/.local/bin/pipenv run pytest'
                }
            }
        }

        stage('Package') {
            steps {
                // Create zip excluding virtual environment
                sh 'zip -r retailproject.zip . -x "retail_pipeline_venv/*"'
            }
        }

        stage('Deploy') {
            steps {
                // Deploy artifact
                sh 'sshpass -p $LABS_PSW scp -o StrictHostKeyChecking=no -r retailproject.zip $LABS_USR@g02.itversity.com:/home/itv012419/retailproject'
            }
        }
    }
}